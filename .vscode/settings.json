{
  // This paper REQUIRES XeLaTeX (Thai script + fontspec). The default
  // LaTeX Workshop "latexmk" recipe passes `-pdf` (pdflatex), which
  // overrides the .latexmkrc and breaks Thai / citations. Force XeLaTeX:
  "latex-workshop.latex.recipes": [
    {
      "name": "xelatex (latexmk, Thai)",
      "tools": ["latexmk-xelatex"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-xelatex",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {}
    }
  ],
  "latex-workshop.latex.recipe.default": "xelatex (latexmk, Thai)",
  "latex-workshop.latex.autoBuild.run": "onSave"
}
